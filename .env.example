# FrameCutAI local MVP configuration
#
# Keep real credentials in your local .env file only. The MVP defaults to mock
# providers so the app can run without paid API access.

FRAMECUTAI_PROVIDER_MODE=mock
FRAMECUTAI_ASR_PROVIDER=mock
FRAMECUTAI_LLM_PROVIDER=mock
FRAMECUTAI_VISION_PROVIDER=mock

FRAMECUTAI_ASR_MODEL=mock-asr
FRAMECUTAI_LLM_MODEL=mock-llm
FRAMECUTAI_VISION_MODEL=mock-vision

# Future OpenAI-compatible Provider settings. Leave empty for mock mode.
OPENAI_API_KEY=
FRAMECUTAI_OPENAI_BASE_URL=

# Local file safety defaults.
FRAMECUTAI_MAX_VIDEO_BYTES=524288000
FRAMECUTAI_ACCEPTED_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm,.avi
